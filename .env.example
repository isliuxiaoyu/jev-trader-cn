# Paper research platform. Real broker stays off.
REAL_BROKER=false

# baseline-momentum | baseline-random | agent-jev | nimble | nimble-9b | jev | decider-2b | llm
MODEL=baseline-momentum
# Optional extra models scored on the same state. They do not place orders.
COMPARE_MODELS=

# replay | backtest | paper
MODE=replay
# mock | csv | ifind
DATA=mock
SYMBOL=600519.SH
CSV_PATH=
SCHEMA=direction_5m_v1
POLICY=threshold-v1
RULES=AStock-MainBoard-v1
EXECUTION=BestAskPlusSlippage
HORIZON_MS=300000
DECISION_INTERVAL_MS=60000
CASH=200000
EXPERIMENT_ID=2026-A-001
PORT=3000

# Typed decision servers. Generation temperature is ignored unless the adapter declares it.
MODEL_ENDPOINT=
MODEL_PATH=
MODEL_REVISION=
MODEL_DEVICE=auto
MODEL_DTYPE=bf16
MODEL_MAX_INPUT_TOKENS=2048
MODEL_TIMEOUT_MS=8000
MODEL_CACHE=true
MODEL_BASE=Qwen/Qwen3.5-9B
MODEL_ADAPTER=bespokelabs/Bespoke-Nimble-9B

# Text models only. Typed decision adapters do not read this.
MODEL_TEMPERATURE=
MODEL_REMOTE=
MODEL_API_KEY=

# TypeSafe Jev. Used only when MODEL=jev.
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# iFinD. The feature engine never calls these directly.
IFIND_ENDPOINT=https://quantapi.51ifind.com/api/v1
IFIND_ACCESS_TOKEN=
IFIND_REFRESH_TOKEN=
